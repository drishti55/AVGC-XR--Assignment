# Copy to backend/.env and fill in. Never commit the real .env.

# --- Primary LLM: Google Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Second attempt when the main model is overloaded (empty to skip)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
# minimal | low | medium | high  (minimal: ~6 s per answer, default: ~25 s)
GEMINI_THINKING_LEVEL=minimal

# --- Fallback LLM: local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# --- Retrieval ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=4
# Calibrated with scripts/eval_retrieval.py (milestone M4)
SEMANTIC_THRESHOLD=0.80
STRONG_SEMANTIC_THRESHOLD=0.85
BM25_THRESHOLD=6.0

# --- App ---
DATABASE_PATH=data/garuda.db
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=10/minute
