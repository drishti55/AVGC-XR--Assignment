# Copy to backend/.env and fill in. Never commit the real .env.

# --- Primary LLM: Google Gemini (free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Fallback LLM: local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=90

# --- Retrieval ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=4
# Calibrated with scripts/eval_retrieval.py (milestone M4)
SEMANTIC_THRESHOLD=0.80

# --- App ---
DATABASE_PATH=data/garuda.db
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=10/minute
